# Copy this file to ".env" and fill in your own keys.
# In production (Hugging Face Spaces / Render) set these as platform secrets
# instead of committing a .env file.

# Required for LLM-generated recommendations.
# Without it the app uses a transparent rule-based fallback engine.
OPENAI_API_KEY=

# Required for fetching financial news from https://newsapi.org
# Without it the news + sentiment panels are simply skipped.
NEWS_API_KEY=

# Required for AI chatbot — pick one (Groq recommended, Gemini as fallback)
# Groq: free at https://console.groq.com (30 RPM, 14400 RPD)
GROQ_API_KEY=
# Gemini: free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown).
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
