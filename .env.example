# ---- Finnhub (market data + news) -------------------------------------------
# Free at https://finnhub.io — 60 calls/min
FINNHUB_API_KEY=

# ---- OpenAI (LLM recommendations) ------------------------------------------
# Without it the app uses a rule-based fallback engine.
OPENAI_API_KEY=

# ---- Chatbot (free tier — pick at least one) --------------------------------
# Groq: free at https://console.groq.com (recommended)
GROQ_API_KEY=
# Gemini: free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- User database + auth ---------------------------------------------------
# Leave DATABASE_URL unset to use a local SQLite file (zero setup) for dev.
# In production set it to a Postgres URL, e.g. from Neon / Supabase / Render:
#   DATABASE_URL=postgresql://user:password@host:5432/dbname
DATABASE_URL=
# Secret used to sign login session tokens. CHANGE THIS in production.
SECRET_KEY=dev-insecure-change-me
# How long a login session stays valid, in hours (default 7 days).
SESSION_TTL_HOURS=168

# ---- Optional overrides ----------------------------------------------------
LLM_MODEL=gpt-4.1
LLM_TEMPERATURE=0.2
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
